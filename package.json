{
  "name": "soyul-audiometry",
  "private": true,
  "version": "0.1.0",
  "description": "소율한의원 순음청력검사 보조 및 개인별 음향자극음 생성 프로그램 (브라우저 전용, 서버 없음)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "build:pages": "tsc -b && vite build --base=/soyul-audiometry/",
    "deploy": "npm run build:pages && gh-pages -d dist --nojekyll -m \"Deploy to GitHub Pages\""
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
